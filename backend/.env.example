# Copy to .env and supply local credentials. Never commit .env.
DB_NAME=volunteer_local
DB_USER=volunteer_local
DB_PASS=
DB_HOST=127.0.0.1
NODE_ENV=development
PORT=3000
URL=http://localhost:3000
UPLOADS=/uploads/
JWT_EXPIRES_IN ='3h'
JWT_SECRET='secret_key'
# JWT signing is currently hardcoded in services/auth.js.
# Adding a variable here alone does not secure authentication; see ../SECURITY_AUDIT.md.
